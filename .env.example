# ─────────────────────────────────────────────
# The Middleman — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# ─────────────────────────────────────────────

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key — server-side only, NEVER expose to the client/browser.
# Used in Edge Functions / server routes that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Payments ──
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# ── Transactional email ──
# Server-side only. Never expose the Resend API key through NEXT_PUBLIC_*.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="The Middleman <notifications@mail.themiddleman.com.ng>"

# ── App Config ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="The Middleman"

# New escrow is disabled unless ALL isolation checks pass. Configure these
# only for fix/paystack-preview-finalization, never the Production environment.
MARKETPLACE_ESCROW_V2_ENABLED=false
MARKETPLACE_ISOLATED_PREVIEW=false
ESCROW_GATEWAY_TEST_ENABLED=false
# Checkout requires both Paystack keys to start with sk_test_ / pk_test_.
# Use a fresh server quote (maximum age 24 hours); 1500 is only an example.
ESCROW_FX_NGN_PER_USD=
ESCROW_FX_QUOTED_AT=
ESCROW_FX_SOURCE=
# Random server-only bearer secret, at least 32 characters.
ESCROW_CRON_SECRET=
