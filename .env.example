# ==========================================
# THE MIDDLEMAN - LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# Copy this file to a new file named '.env.local' and fill in the secrets.
# NEVER commit your actual '.env.local' file to GitHub.
# ==========================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here

# Next.js Site URL (for local testing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
